{
  "name": "@dsh-external/dsh-verifier-pro",
  "version": "0.4.9",
  "description": "LLM-as-a-Verifier brain for DSH agent teams: fine-grained verification (select/compare/track/progress) via official llm-verifier Python bridge, with team best-of-N selection and reviewer quality gates",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "bridge",
    "scripts/probe_logprobs.py",
    "scripts/setup.mjs",
    "scripts/evidence_chain.mjs",
    "scripts/smoke.mjs",
    "scripts/describe_visual.mjs",
    "scripts/build_evidence.mjs",
    "scripts/bestofn-usage.cjs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "BSD-3-Clause",
  "author": {
    "name": "dsh-verifier-Pro authors"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Animal2404/dsh-verifier-Pro.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "llm-as-a-verifier",
    "verifier",
    "best-of-n",
    "agent-teams",
    "reward-model",
    "llm"
  ],
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-runtime": ">=0.1.0-rc <2",
    "@deepseek-ai/dsh-commands": ">=0.1.0-rc <2",
    "@deepseek-ai/dsh-llm": ">=0.0.1-rc <2",
    "@deepseek-ai/dsh-system-prompt": ">=0.0.1-rc <2",
    "@deepseek-ai/dsh-tools": ">=0.0.1-rc <2",
    "cordis": ">=4.0.0-rc <5",
    "dsh-client-ui-slots": ">=0.1.0-rc <2",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "schemastery": "^3.18.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-commands": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "tsdown": "^0.11.0",
    "typescript": "^5.9.0"
  },
  "scripts": {
    "build": "bash scripts/build.sh",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run typecheck && npm run test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  }
}
