{
  "name": "@dsh-external/dsh-verifier-brain",
  "version": "0.2.0",
  "description": "LLM-as-a-Verifier brain for DSH agent teams: fine-grained verification (select/compare/track/progress) via official llm-verifier Python bridge, with team best-of-N selection and reviewer quality gates",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "files": [
    "lib",
    "bridge",
    "scripts/probe_logprobs.py",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "BSD-3-Clause",
  "author": {
    "name": "dsh-verifier-brain authors"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Animal2404/dsh-verifier-brain.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "llm-as-a-verifier",
    "verifier",
    "best-of-n",
    "agent-teams",
    "reward-model",
    "llm"
  ],
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": ">=0.0.1-rc <2",
    "@deepseek-ai/dsh-system-prompt": ">=0.0.1-rc <2",
    "@deepseek-ai/dsh-tools": ">=0.0.1-rc <2",
    "cordis": ">=4.0.0-rc <5",
    "schemastery": "^3.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.9.0"
  },
  "scripts": {
    "build": "bash scripts/build.sh",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
